# Environment Configuration for Hostinger Deployment
# Copy this to your Hostinger root or use as reference

# ========== HOSTINGER EMAIL CONFIGURATION ==========
# These are the emails that will receive contact form submissions
# Configure these to match your email accounts on Hostinger

CONTACT_EMAIL_1=hello.gitltz@gmail.com
CONTACT_EMAIL_2=sid@gammainternationaltz.com
CONTACT_EMAIL_3=vijay@gammainternationaltz.com
CONTACT_EMAIL_4=Himanshu@gammainternationaltz.com
CONTACT_EMAIL_5=info@gammainternationaltz.com

# ========== FRONTEND CONFIGURATION ==========
# Set this if you want to override the PHP endpoint
# By default, the frontend will call /api/contact.php from the same domain
# VITE_PHP_API_URL=https://your-domain.com/api/contact.php

# ========== DEVELOPMENT ==========
# Use this for local testing with the Node.js backend
# VITE_API_URL=http://localhost:5000

# ========== NOTES ==========
# 1. Make sure PHP mail() is enabled on your Hostinger account
# 2. Verify you have email accounts created for the domain
# 3. Check MX records are properly configured on Hostinger
# 4. Monitor email delivery in Hostinger control panel → Email → Mail Log
