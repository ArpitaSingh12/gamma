# ==========================================
# FRONTEND (Vercel)
# ==========================================
# Backend API URL - set this in Vercel dashboard
VITE_API_URL=https://gamma-backend.onrender.com

# ==========================================
# BACKEND (Render)
# ==========================================
# Node environment
NODE_ENV=production

# Port for the Express server
PORT=10000

# SendGrid email configuration
SENDGRID_API_KEY=SG.your_api_key_here
SENDGRID_FROM_EMAIL=noreply@gammainternationaltz.com

# Comma-separated list of email addresses to receive contact form submissions
CONTACT_RECIPIENTS=hello.gitltz@gmail.com,sid@gammainternationaltz.com,vijay@gammainternationaltz.com,Himanshu@gammainternationaltz.com,info@gammainternationaltz.com

# Database URL (if using database)
# DATABASE_URL=postgresql://user:password@host:port/database

# ==========================================
# LOCAL DEVELOPMENT (.env.local)
# ==========================================
# Override settings for local development
VITE_API_URL=http://localhost:5000
SENDGRID_API_KEY=SG.test_key_here
